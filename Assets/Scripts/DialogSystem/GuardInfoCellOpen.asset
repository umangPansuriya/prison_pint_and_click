  Lines:
  - SpeakerName: Surveillance Officer
    dialogueType: 2
    Text: Command, this is Surveillance. Cell 17 just triggered an unlock. The door's
      status changed.
    SpeakerSprite: {fileID: 0}
    IsLeftSide: 0
  - SpeakerName: Surveillance Officer
    dialogueType: 2
    Text: Repeat, Cell 17 is open. Possible escape attempt in progress.
    SpeakerSprite: {fileID: 0}
    IsLeftSide: 0
  - SpeakerName: Guard
    dialogueType: 2
    Text: Copy that. I'm on my way to Cell 17. Keep eyes on the corridor feed.
    SpeakerSprite: {fileID: 0}
    IsLeftSide: 0
  - SpeakerName: Surveillance Officer
    dialogueType: 2
    Text: Roger. Switching cameras to Sector 3 now.
    SpeakerSprite: {fileID: 0}
    IsLeftSide: 0
